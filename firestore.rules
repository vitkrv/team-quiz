rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /artifacts/{appId}/public/data/packs/{packId} {
      allow read: if isAdmin(appId)
        || (
          isGoogleUser()
          && (
            resource.data.ownerId == request.auth.uid
            || resource.data.isPublic == true
          )
        );
      allow create: if isGoogleUser()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isGoogleUser()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isGoogleUser()
        && resource.data.ownerId == request.auth.uid;
    }

    match /artifacts/{appId}/public/data/roomCodes/{code} {
      allow read: if isGoogleUser() || isAdmin(appId);
      allow create: if isGoogleUser() && validReservation(appId, code);
      allow update: if isGoogleUser()
        && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(resource.data.gameId)).data.status == 'finished'
        && validReservation(appId, code);
      allow delete: if false;
    }

    match /artifacts/{appId}/public/data/rooms/{gameId} {
      allow read: if isAdmin(appId) || isGoogleUser();
      allow create: if isGoogleUser()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.buzzerPolicyVersion == 1 && request.resource.data.buzzerRoundId == null
        && request.resource.data.dataVersion == 2
        && !request.resource.data.keys().hasAny(['pack', 'history'])
        && request.resource.data.packVersionId == null
        && validPackSummary(request.resource.data.packSummary)
        && gameId.matches('^[A-Za-z0-9]{20}$')
        && request.resource.data.status == 'lobby'
        && request.resource.data.roomCode is string
        && request.resource.data.roomCode.matches('^[0-9]{6}$')
        && getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/roomCodes/$(request.resource.data.roomCode)).data.gameId == gameId
        && request.resource.data.packId is string
        && canHostPack(appId, request.resource.data.packId, request.auth.uid);
      allow update: if isGoogleUser()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['roomCode', 'hostId', 'recapVersion', 'buzzerPolicyVersion'])
        && validBuzzerRoomUpdate(appId, gameId, resource.data, request.resource.data)
        && validGameStorageUpdate(appId, gameId, resource.data, request.resource.data)
        && validWheelRoomUpdate(appId, gameId, resource.data, request.resource.data)
        && (
          (
            roomParticipantOrHost(resource.data, request.auth.uid)
            && validTrueCompetitiveModeUpdate(resource.data, request.resource.data, request.auth.uid)
          )
          || canJoinLobby(resource.data, request.resource.data, request.auth.uid)
        );
      allow delete: if false;
    }

    match /artifacts/{appId}/public/data/rooms/{gameId}/history/{eventId} {
      allow read: if isGoogleUser()
        && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(gameId)).data.hostId == request.auth.uid;
      allow create: if isGoogleUser() && validHistoryEvent(appId, gameId, eventId);
      allow update, delete: if false;
    }

    function pendingSurpriseAward(room) {
      let round = room.get('surpriseRound', null);
      return round != null && round.get('judgeResult', null) != null && round.get('scoreAppliedAt', null) == null;
    }

    function validWheelRoomUpdate(appId, gameId, before, after) {
      return before.get('dataVersion', 0) != 2 || before.get('recapVersion', 0) != 1
        || before.get('buzzerPolicyVersion', 0) != 1
        || ((!pendingSurpriseAward(before)
            || (after.status == 'playing' && after.activeQuestionId == before.activeQuestionId
              && after.get('surpriseRound', null) != null))
          && validWheelTransition(appId, gameId, before, after));
    }

    function validWheelTransition(appId, gameId, before, after) {
      let previous = before.get('surpriseRound', null);
      let next = after.get('surpriseRound', null);
      let previousSpin = previous == null ? null : previous.get('spinId', null);
      let nextSpin = next == null ? null : next.get('spinId', null);
      return previousSpin == null && nextSpin == null
        ? !(previous != null && previous.get('scoringMechanic', '') == 'wheel'
            && pendingSurpriseAward(before) && next != previous)
        : previousSpin == null
          ? validWheelStart(appId, gameId, before, after)
          : (next == previous
            || (previous.get('scoreAppliedAt', null) != null && next == null
              && request.auth.uid == before.hostId && after.activeQuestionId == null)
            || (previous.get('scoreAppliedAt', null) == null && validWheelCompletion(appId, gameId, before, after)));
    }

    function validWheelStart(appId, gameId, before, after) {
      let previous = before.surpriseRound;
      let next = after.surpriseRound;
      let eventId = 'wheel_' + next.spinId + '_started';
      let event = getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(gameId)/history/$(eventId)).data;
      return before.status == 'playing' && before.answerRevealed
        && previous.questionId == before.activeQuestionId && previous.judgeResult != null
        && previous.scoringMechanic == 'wheel' && previous.get('rollResult', null) == null
        && request.auth.uid in [before.hostId, previous.answererId]
        && before.players[previous.answererId].isHost == false
        && next.spinId is string && next.spinId.size() > 0 && next.spinId.size() <= 100
        && next.rolledAt == request.time && next.durationMs == 6000
        && next.rolledBy == request.auth.uid && next.scoreAppliedAt == null
        && next.rollResult is number && next.rollResult in previous.wheelValues
        && next.diff(previous).affectedKeys().hasOnly(['spinId', 'durationMs', 'rollResult', 'rolledAt', 'rolledBy', 'scoreAppliedAt'])
        && after.diff(before).affectedKeys().hasOnly(['surpriseRound'])
        && event.id == eventId && event.type == 'surprise_wheel_rolled'
        && event.actorId == request.auth.uid && event.recordedAt == request.time
        && event.details.spinId == next.spinId && event.details.points == next.rollResult
        && event.details.playerId == previous.answererId && event.details.questionId == before.activeQuestionId;
    }

    function validWheelAward(before, after) {
      let previous = before.surpriseRound;
      let next = after.surpriseRound;
      let uid = previous.answererId;
      return before.status == 'playing' && before.answerRevealed
        && previous.questionId == before.activeQuestionId && previous.judgeResult != null
        && previous.scoringMechanic == 'wheel' && previous.get('scoreAppliedAt', null) == null
        && request.auth.uid in [before.hostId, uid] && before.players[uid].isHost == false
        && previous.rolledAt is timestamp && previous.durationMs == 6000
        && request.time >= previous.rolledAt + duration.value(6000, 'ms')
        && previous.rollResult is number && previous.rollResult in previous.wheelValues
        && next.diff(previous).affectedKeys().hasOnly(['scoreAppliedAt'])
        && next.scoreAppliedAt == request.time && after.currentTurn == uid
        && after.players[uid].score == before.players[uid].score + previous.rollResult
        && after.players.diff(before.players).affectedKeys().hasOnly([uid])
        && after.players[uid].diff(before.players[uid]).affectedKeys().hasOnly(['score'])
        && after.diff(before).affectedKeys().hasOnly(['players', 'currentTurn', 'surpriseRound']);
    }

    function validWheelCompletion(appId, gameId, before, after) {
      let round = before.surpriseRound;
      let eventId = 'wheel_' + round.spinId + '_scored';
      let event = getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(gameId)/history/$(eventId)).data;
      let recap = getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(gameId)/recap/summary).data;
      let score = getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(gameId)/recapScores/$(eventId)).data;
      return validWheelAward(before, after)
        && event.id == eventId && event.type == 'surprise_wheel_scored'
        && event.actorId == request.auth.uid && event.recordedAt == request.time
        && event.details.spinId == round.spinId && event.details.points == round.rollResult
        && event.details.rolledAt == round.rolledAt && event.details.playerId == round.answererId
        && event.details.questionId == before.activeQuestionId
        && recap.lastEventId == eventId && score.id == eventId
        && score.playerId == round.answererId && score.delta == round.rollResult;
    }

    // Policy v1 trusts local reaction measurements and host ranking, not arbitrary
    // contestant room writes. All acceptance boundaries use Firestore commit time.
    function validBuzzerRoomUpdate(appId, gameId, before, after) {
      return before.get('buzzerPolicyVersion', 0) != 1
        || (!after.diff(before).affectedKeys().hasAny(['buzzerRoundId', 'buzzedPlayerId', 'buzzTimestamp',
              'buzzAttempts', 'buzzUnlockAt', 'incorrectBuzzedIds', 'activeQuestionId', 'answerRevealed',
              'questionStates', 'status'])
          || (request.auth.uid == before.hostId && hostBuzzerRoomUpdate(appId, gameId, before, after))
          || (before.status == 'lobby' && after.status == 'lobby' && canJoinLobby(before, after, request.auth.uid)));
    }

    function hostBuzzerRoomUpdate(appId, gameId, before, after) {
      let race = getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(gameId)/buzzer/current);
      return after.get('buzzerRoundId', null) == null
        || (race.data.raceId == after.buzzerRoundId
          && (after.status == 'finished' || after.answerRevealed || after.activeQuestionId == null
            ? race.data.phase == 'cancelled'
            : race.data.questionId == after.activeQuestionId
              && (after.buzzedPlayerId == null ? race.data.phase in ['open', 'collecting']
                : race.data.phase == 'resolved' && after.buzzedPlayerId in race.data.attempts)));
    }

    match /artifacts/{appId}/public/data/rooms/{gameId}/buzzer/{buzzerId} {
      allow read: if isGoogleUser();
      allow create: if buzzerId == 'current' && isGoogleUser() && validBuzzerOpen(appId, gameId, false);
      allow update: if buzzerId == 'current' && isGoogleUser()
        && (validBuzzerHostWrite(appId, gameId) || validBuzzerPlayerWrite(appId, gameId));
      allow delete: if false;
    }

    function validBuzzerOpen(appId, gameId, replacing) {
      let before = get(/databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(gameId)).data;
      let room = getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(gameId)).data;
      let race = request.resource.data;
      let pack = get(/databases/$(database)/documents/artifacts/$(appId)/public/data/gamePackVersions/$(room.packVersionId)).data.content;
      let question = pack.categories[race.categoryIndex].questions[race.questionIndex];
      return room.hostId == request.auth.uid && room.buzzerPolicyVersion == 1 && room.status == 'playing'
        && race.keys().hasOnly(['raceId', 'questionId', 'categoryIndex', 'questionIndex', 'phase', 'openedAt',
          'openingDelayMs', 'firstAcceptedAt', 'attempts', 'penalties', 'earlyOperations'])
        && race.raceId is string && race.raceId == room.buzzerRoundId && race.raceId != before.get('buzzerRoundId', null)
        && race.questionId == room.activeQuestionId && question.id == race.questionId && !question.get('isSurpriseQuestion', false)
        && !room.answerRevealed && room.buzzedPlayerId == null && race.phase == 'open'
        && race.openedAt == request.time && race.firstAcceptedAt == null && race.attempts == {}
        && (replacing && before.activeQuestionId == room.activeQuestionId
          ? race.openingDelayMs == 0 && race.penalties == resource.data.penalties && race.earlyOperations == resource.data.earlyOperations
            && before.buzzedPlayerId != null && before.buzzedPlayerId in room.incorrectBuzzedIds
          : race.openingDelayMs == 2000 && race.penalties == {} && race.earlyOperations == {});
    }

    function validBuzzerHostWrite(appId, gameId) {
      let before = resource.data;
      let after = request.resource.data;
      let room = getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(gameId)).data;
      return request.auth.uid == room.hostId && room.buzzerPolicyVersion == 1
        && (after.raceId != before.raceId ? validBuzzerOpen(appId, gameId, true)
          : after.diff(before).affectedKeys().hasOnly(['phase'])
            && (after.phase == 'cancelled'
              ? room.status == 'finished' || room.answerRevealed || room.activeQuestionId != before.questionId || room.get('buzzerRoundId', null) == null
              : before.phase == 'collecting' && after.phase == 'resolved'
                && request.time >= before.firstAcceptedAt + duration.value(2000, 'ms')
                && room.buzzerRoundId == before.raceId && room.buzzedPlayerId in before.attempts
                && room.buzzTimestamp == request.time));
    }

    function validBuzzerPlayerWrite(appId, gameId) {
      let room = get(/databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(gameId)).data;
      let before = resource.data;
      let after = request.resource.data;
      let uid = request.auth.uid;
      return room.buzzerPolicyVersion == 1 && room.status == 'playing' && !room.answerRevealed
        && room.buzzedPlayerId == null && room.buzzerRoundId == before.raceId && room.activeQuestionId == before.questionId
        && uid in room.players && room.players[uid].isHost == false && !(uid in room.incorrectBuzzedIds)
        && (validBuzzerSubmission(before, after, uid) || validBuzzerPenalty(appId, gameId, room, before, after, uid));
    }

    function validBuzzerSubmission(before, after, uid) {
      let attempt = after.attempts[uid];
      return before.phase in ['open', 'collecting'] && after.phase == 'collecting'
        && after.diff(before).affectedKeys().hasOnly(['phase', 'firstAcceptedAt', 'attempts'])
        && !(uid in before.attempts) && after.attempts.size() <= 20
        && after.attempts.diff(before.attempts).affectedKeys().hasOnly([uid])
        && attempt.keys().hasOnly(['playerId', 'reactionMs', 'operationId', 'acceptedAt'])
        && attempt.playerId == uid && attempt.operationId is string && attempt.operationId.size() > 0
        && attempt.operationId.size() <= 128 && attempt.acceptedAt == request.time
        && attempt.reactionMs is number && attempt.reactionMs >= 0 && attempt.reactionMs < 1000000000000000
        && request.time >= before.openedAt + duration.value(before.openingDelayMs, 'ms')
        && request.time.toMillis() >= before.penalties.get(uid, 0)
        && (before.phase == 'open' ? after.firstAcceptedAt == request.time
          : after.firstAcceptedAt == before.firstAcceptedAt
            && request.time < before.firstAcceptedAt + duration.value(2000, 'ms'));
    }

    function validBuzzerPenalty(appId, gameId, room, before, after, uid) {
      let event = getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(gameId)/history/$(after.earlyOperations[uid])).data;
      return room.trueCompetitiveMode && before.phase == 'open' && before.openingDelayMs == 2000
        && !(uid in before.penalties) && after.diff(before).affectedKeys().hasOnly(['penalties', 'earlyOperations'])
        && after.penalties.diff(before.penalties).affectedKeys().hasOnly([uid])
        && after.earlyOperations.diff(before.earlyOperations).affectedKeys().hasOnly([uid])
        && after.penalties[uid] == before.openedAt.toMillis() + 4500
        && event.actorId == uid && event.type == 'player_buzzed_early' && event.details.raceId == before.raceId
        && event.recordedAt == request.time;
    }

    function validPolicyEarlyEvent(appId, gameId, event, uid) {
      let path = /databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(gameId)/buzzer/current;
      let before = get(path).data;
      let after = getAfter(path).data;
      return event.type == 'player_buzzed_early' && before.raceId == event.details.raceId
        && !(uid in before.penalties) && after.earlyOperations[uid] == event.id;
    }

    match /artifacts/{appId}/public/data/gamePackVersions/{versionId} {
      allow read: if isGoogleUser() || isAdmin(appId);
      allow create: if isGoogleUser() && validPackVersion(appId, versionId);
      allow update: if false;
      allow delete: if isGoogleUser()
        && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(resource.data.gameId)).data.hostId == request.auth.uid
        && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(resource.data.gameId)).data.status in ['playing', 'category_preview']
        && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(resource.data.gameId)).data.packVersionId == versionId
        && getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(resource.data.gameId)).data.status == 'finished';
    }

    function validPackSummary(summary) {
      return summary is map && summary.keys().hasOnly(['name', 'iconEmoji'])
        && summary.name is string && summary.iconEmoji is string;
    }

    function validGameStorageUpdate(appId, gameId, before, after) {
      return before.get('dataVersion', 1) != 2
        ? !after.diff(before).affectedKeys().hasAny(['dataVersion'])
        : after.dataVersion == 2
          && !after.keys().hasAny(['pack', 'history'])
          && after.packId == before.packId
          && validPackSummary(after.packSummary)
          && (after.packSummary == before.packSummary || (before.status == 'lobby' && before.hostId == request.auth.uid))
          && (after.status == before.status || before.hostId == request.auth.uid)
          && (before.status != 'finished' || after.status == 'finished')
          && validPackLifecycle(appId, gameId, before, after)
          && (before.get('recapVersion', 0) != 1 || before.status != 'finished' || after == before)
          && (before.get('recapVersion', 0) != 1 || before.status == 'finished' || after.status != 'finished'
            || getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(gameId)/recap/summary).data.finalized == true);
    }

    function validPackLifecycle(appId, gameId, before, after) {
      return before.status == 'lobby'
        ? ((after.status == 'lobby' && after.packVersionId == null)
          || (before.hostId == request.auth.uid
            && after.status in ['category_preview', 'playing']
            && after.packVersionId is string
            && !exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/gamePackVersions/$(after.packVersionId))
            && getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/gamePackVersions/$(after.packVersionId)).data.gameId == gameId))
        : after.packVersionId == before.packVersionId
          && after.status != 'lobby'
          && (before.status == 'finished' || after.status != 'finished'
            || (before.hostId == request.auth.uid
              && !existsAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/gamePackVersions/$(before.packVersionId))));
    }

    function validPackVersion(appId, versionId) {
      let version = request.resource.data;
      let roomPath = /databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(version.gameId);
      let before = get(roomPath).data;
      let after = getAfter(roomPath).data;
      return version.keys().hasOnly(['gameId', 'sourcePackId', 'schemaVersion', 'createdAt', 'content'])
        && version.schemaVersion == 1 && version.createdAt == request.time
        && before.dataVersion == 2 && before.hostId == request.auth.uid
        && before.status == 'lobby' && before.packVersionId == null
        && after.status in ['category_preview', 'playing'] && after.packVersionId == versionId
        && version.sourcePackId == before.packId
        && canHostPack(appId, version.sourcePackId, request.auth.uid)
        && version.content == get(/databases/$(database)/documents/artifacts/$(appId)/public/data/packs/$(version.sourcePackId)).data;
    }

    function validHistoryEvent(appId, gameId, eventId) {
      let event = request.resource.data;
      let roomPath = /databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(gameId);
      let after = getAfter(roomPath).data;
      return after.dataVersion == 2
        && event.keys().hasOnly(['id', 'type', 'actorId', 'actorName', 'message', 'details', 'timestamp', 'recordedAt'])
        && event.id == eventId && event.actorId == request.auth.uid
        && event.actorName is string && event.message is string && event.details is map
        && event.timestamp is number && event.recordedAt == request.time
        && (after.get('recapVersion', 0) != 1 || after.hostId == request.auth.uid
          || !(event.type in ['player_buzzed', 'player_buzzed_late', 'player_buzzed_early', 'surprise_table_picked', 'surprise_wheel_scored'])
          || getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(gameId)/recap/summary).data.lastEventId == eventId)
        && (after.hostId == request.auth.uid
          || (request.auth.uid in after.players
            && event.actorName == after.players[request.auth.uid].name
            && (after.get('buzzerPolicyVersion', 0) == 1 && event.type == 'player_buzzed_early'
              ? validPolicyEarlyEvent(appId, gameId, event, request.auth.uid)
              : validPlayerEvent(get(roomPath).data, after, event, request.auth.uid))));
    }

    function validPlayerEvent(before, after, event, uid) {
      return before.status == 'playing' && after.status == 'playing'
        && uid in before.players && before.players[uid].isHost == false
        && before.activeQuestionId != null && before.activeQuestionId == after.activeQuestionId
        && ((event.type in ['player_buzzed', 'player_buzzed_late'] && validBuzzEvent(before, after, event, uid))
          || (event.type in ['surprise_table_picked', 'surprise_wheel_rolled'] && validSurpriseEvent(before, after, event, uid))
          || (event.type == 'player_buzzed_early' && validEarlyEvent(before, after, event, uid))
          || (event.type == 'surprise_wheel_scored' && validWheelScore(before, after, event, uid)));
    }

    function validBuzzEvent(before, after, event, uid) {
      let attempt = after.buzzAttempts[uid];
      return !before.answerRevealed && !after.answerRevealed
        && !(uid in before.incorrectBuzzedIds)
        && attempt.questionId == before.activeQuestionId
        && attempt != before.buzzAttempts.get(uid, null)
        && attempt.clickedAt >= before.buzzUnlockAt
        && event.details.actorName == before.players[uid].name
        && after.diff(before).affectedKeys().hasOnly(['buzzedPlayerId', 'buzzTimestamp', 'buzzAttempts'])
        && after.buzzAttempts.diff(before.buzzAttempts).affectedKeys().hasOnly([uid])
        && (event.type == 'player_buzzed'
          ? before.buzzedPlayerId == null && after.buzzedPlayerId == uid && after.buzzTimestamp == attempt.clickedAt
          : before.buzzedPlayerId != null && before.buzzedPlayerId != uid
            && after.buzzedPlayerId == before.buzzedPlayerId && after.buzzTimestamp == before.buzzTimestamp
            && attempt.clickedAt > before.buzzTimestamp && attempt.clickedAt - before.buzzTimestamp <= 3500
            && (before.buzzAttempts.get(uid, null) == null || attempt.clickedAt < before.buzzAttempts[uid].clickedAt)
            && event.details.deltaMs == attempt.clickedAt - before.buzzTimestamp
            && event.details.playerName == before.players[before.buzzedPlayerId].name);
    }

    function validSurpriseEvent(before, after, event, uid) {
      let previous = before.surpriseRound;
      let next = after.surpriseRound;
      return before.answerRevealed && after.answerRevealed && previous.judgeResult != null
        && previous.answererId == uid && next.answererId == uid
        && previous.questionId == before.activeQuestionId && next.questionId == previous.questionId
        && event.details.playerName == before.players[uid].name
        && (event.type == 'surprise_wheel_rolled'
          ? previous.get('rollResult', null) == null && next.rolledBy == uid
            && next.rollResult in previous.wheelValues && event.details.points == next.rollResult
            && after.diff(before).affectedKeys().hasOnly(['surpriseRound'])
            && next.diff(previous).affectedKeys().hasOnly(['rollResult', 'rolledAt', 'rolledBy', 'scoreAppliedAt', 'spinId', 'durationMs'])
          : previous.get('tablePickedCellId', null) == null && next.tablePickedBy == uid
            && previous.scoringMechanic == 'table'
            && event.details.cellIndex is int && event.details.cellIndex >= 0 && event.details.cellIndex < previous.tableCells.size()
            && next.tablePickedCellId == previous.tableCells[event.details.cellIndex].id
            && event.details.points == previous.tableCells[event.details.cellIndex].value
            && after.players[uid].score == before.players[uid].score + event.details.points
            && after.players.diff(before.players).affectedKeys().hasOnly([uid])
            && after.players[uid].diff(before.players[uid]).affectedKeys().hasOnly(['score'])
            && next.diff(previous).affectedKeys().hasOnly(['tablePickedCellId', 'tablePickedAt', 'tablePickedBy', 'scoreAppliedAt'])
            && after.diff(before).affectedKeys().hasOnly(['players', 'currentTurn', 'surpriseRound']));
    }

    function validEarlyEvent(before, after, event, uid) {
      return before.get('recapVersion', 0) == 1 && before.trueCompetitiveMode
        && !before.answerRevealed && before.buzzedPlayerId == null
        && !(uid in before.incorrectBuzzedIds) && after == before
        && event.details.questionId == before.activeQuestionId
        && event.details.clickedAt is number && event.details.clickedAt < before.buzzUnlockAt;
    }

    function validWheelScore(before, after, event, uid) {
      return before.surpriseRound.get('spinId', null) != null
        // The room write validates the deadline, immutable spin and exact score
        // delta once. Related records must accompany that same first completion;
        // avoid repeating full validation across this multi-document commit.
        ? before.get('dataVersion', 0) == 2 && before.get('recapVersion', 0) == 1
          && before.get('buzzerPolicyVersion', 0) == 1
          && before.surpriseRound.get('scoreAppliedAt', null) == null
          && after.surpriseRound.scoreAppliedAt == request.time
          && after.surpriseRound.spinId == before.surpriseRound.spinId
          && uid == before.surpriseRound.answererId
          && event.id == 'wheel_' + before.surpriseRound.spinId + '_scored'
          && event.details.points == before.surpriseRound.rollResult
          && event.details.spinId == before.surpriseRound.spinId
          && event.details.rolledAt == before.surpriseRound.rolledAt
        : before.answerRevealed && after.answerRevealed
        && before.surpriseRound.answererId == uid && before.surpriseRound.get('scoreAppliedAt', null) == null
        && before.surpriseRound.rollResult is number
        && event.details.points == before.surpriseRound.rollResult
        && event.details.rolledAt == before.surpriseRound.rolledAt
        && after.players[uid].score == before.players[uid].score + event.details.points
        && after.players.diff(before.players).affectedKeys().hasOnly([uid])
        && after.players[uid].diff(before.players[uid]).affectedKeys().hasOnly(['score'])
        && after.surpriseRound.diff(before.surpriseRound).affectedKeys().hasOnly(['scoreAppliedAt'])
        && after.surpriseRound.scoreAppliedAt is number && after.currentTurn == uid
        && after.diff(before).affectedKeys().hasOnly(['players', 'currentTurn', 'surpriseRound']);
    }

    match /artifacts/{appId}/public/data/rooms/{gameId}/recap/{recapId} {
      allow read: if isGoogleUser() || isAdmin(appId);
      allow create: if recapId == 'summary' && isGoogleUser()
        && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(gameId)).data.hostId == request.auth.uid
        && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(gameId)).data.status == 'lobby'
        && getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(gameId)).data.get('recapVersion', 0) == 1
        && getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(gameId)).data.status in ['playing', 'category_preview']
        && request.resource.data.version == 1 && request.resource.data.finalized == false;
      allow update: if recapId == 'summary' && isGoogleUser() && !resource.data.finalized
        && validRecapUpdate(appId, gameId, resource.data, request.resource.data);
      allow delete: if false;
    }

    function validRecapUpdate(appId, gameId, before, after) {
      let path = /databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(gameId);
      let room = get(path).data;
      return room.get('recapVersion', 0) == 1 && room.status in ['playing', 'category_preview']
        && after.version == before.version
        && (room.hostId == request.auth.uid
          ? (after.finalized == false
              ? validHostRecapEvent(appId, gameId, room, getAfter(path).data, after)
              : getAfter(path).data.status == 'finished' && after.completedAt == request.time
                && after.players == before.players && after.sequence == before.sequence)
          : validPlayerRecap(appId, gameId, room, getAfter(path).data, before, after));
    }

    function validHostRecapEvent(appId, gameId, room, next, summary) {
      let event = getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(gameId)/history/$(summary.lastEventId)).data;
      return event.actorId == room.hostId && event.recordedAt == request.time
        && (event.type in ['answer_correct', 'answer_incorrect', 'surprise_answer_correct', 'surprise_answer_incorrect',
          'score_set', 'score_adjusted', 'surprise_table_picked', 'surprise_wheel_scored']
          || (room.get('buzzerPolicyVersion', 0) == 1 && event.type in ['player_buzzed', 'player_buzzed_late']
            && event.details.raceId == room.buzzerRoundId))
        && next != room;
    }

    function validPlayerRecap(appId, gameId, room, nextRoom, before, after) {
      let uid = request.auth.uid;
      let event = getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(gameId)/history/$(after.lastEventId)).data;
      let p = before.players[uid];
      let n = after.players[uid];
      return event.actorId == uid && event.recordedAt == request.time
        && (room.get('buzzerPolicyVersion', 0) == 1 && event.type == 'player_buzzed_early'
          ? validPolicyEarlyEvent(appId, gameId, event, uid) : validPlayerEvent(room, nextRoom, event, uid))
        && event.details.playerId == uid && event.details.questionId == room.activeQuestionId
        && after.diff(before).affectedKeys().hasOnly(['sequence', 'lastEventId', 'players'])
        && after.sequence == before.sequence + 1
        && after.players.diff(before.players).affectedKeys().hasOnly([uid])
        && (event.type == 'player_buzzed_early'
          ? p.lastEarlyQuestionId != room.activeQuestionId && n.lastEarlyQuestionId == room.activeQuestionId
            && n.early == p.early + 1 && n.buzzes == p.buzzes + 1
            && n.diff(p).affectedKeys().hasOnly(['lastEarlyQuestionId', 'early', 'buzzes'])
          : event.type in ['player_buzzed', 'player_buzzed_late']
            ? validBuzzRecap(room, event, p, n)
            : event.type in ['surprise_table_picked', 'surprise_wheel_scored'] && validScoreRecap(room, nextRoom, event, p, n, uid));
    }

    function validBuzzRecap(room, event, p, n) {
      let round = room.activeQuestionId + ':' + string(room.incorrectBuzzedIds.size());
      let late = event.type == 'player_buzzed_late';
      let delta = event.details.get('deltaMs', 0);
      return n.lastBuzzRound == round
        && (n.buzzes == p.buzzes + (p.lastBuzzRound == round ? 0 : 1)
            && n.late == p.late + (late && p.lastBuzzRound != round ? 1 : 0)
            && n.diff(p).affectedKeys().hasOnly(['lastBuzzRound', 'buzzes', 'late', 'closestLate'])
            && (late && (p.closestLate == null || delta < p.closestLate.deltaMs)
              ? n.closestLate.deltaMs == delta && n.closestLate.questionId == room.activeQuestionId
                && n.closestLate.categoryId == event.details.categoryId
                && n.closestLate.keys().hasOnly(['deltaMs', 'questionId', 'categoryId', 'categoryName', 'questionPoints'])
              : n.closestLate == p.closestLate));
    }

    function validScoreRecap(room, nextRoom, event, p, n, uid) {
      let cat = event.details.categoryId;
      return n.diff(p).affectedKeys().hasOnly(['categories'])
        && n.categories.diff(p.categories).affectedKeys().hasOnly([cat])
        && n.categories[cat].keys().hasOnly(['name', 'points'])
        && n.categories[cat].points == p.categories.get(cat, {'points': 0}).points + event.details.points
        && nextRoom.players[uid].score == room.players[uid].score + event.details.points;
    }

    match /artifacts/{appId}/public/data/rooms/{gameId}/recapScores/{eventId} {
      allow read: if isGoogleUser() || isAdmin(appId);
      allow create: if isGoogleUser() && validRecapScore(appId, gameId, eventId);
      allow update, delete: if false;
    }

    function validRecapScore(appId, gameId, eventId) {
      let path = /databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(gameId);
      let room = get(path).data;
      let next = getAfter(path).data;
      let score = request.resource.data;
      let event = getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(gameId)/history/$(eventId)).data;
      return room.get('recapVersion', 0) == 1 && room.status in ['playing', 'category_preview']
        && score.id == eventId && event.recordedAt == request.time
        && score.playerId == event.details.playerId && score.source == event.type
        && score.before == room.players[score.playerId].score && score.after == next.players[score.playerId].score
        && score.delta == score.after - score.before && score.sequence is int
        && (room.hostId == request.auth.uid || (score.playerId == request.auth.uid
          && event.type in ['surprise_table_picked', 'surprise_wheel_scored']
          && validPlayerEvent(room, next, event, request.auth.uid)));
    }

    match /artifacts/{appId}/users/{userId}/gameAchievements/{gameId} {
      allow read: if isGoogleUser() && (request.auth.uid == userId || isAdmin(appId));
      allow create: if isGoogleUser() && validProfileAwards(appId, userId, gameId);
      allow update, delete: if false;
    }

    function validProfileAwards(appId, userId, gameId) {
      let path = /databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(gameId);
      let room = get(path).data;
      let recap = getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(gameId)/recap/summary).data;
      let record = request.resource.data;
      return room.hostId == request.auth.uid && room.status in ['playing', 'category_preview']
        && getAfter(path).data.status == 'finished' && recap.finalized
        && userId in room.players && !room.players[userId].isHost
        && record.keys().hasOnly(['version', 'gameId', 'gameCode', 'completedAt', 'awards'])
        && record.version == 1 && record.gameId == gameId && record.gameCode == room.roomCode
        && record.completedAt == request.time && record.completedAt == recap.completedAt
        && record.awards == recap.profileAwards[userId] && record.awards.size() > 0;
    }

    match /artifacts/{appId}/users/{userId} {
      allow read: if isAdmin(appId)
        || (
          isGoogleUser()
          && request.auth.uid == userId
        );
      allow create: if isGoogleUser()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['language', 'updatedAt'])
        && request.resource.data.language in ['en', 'uk'];
      allow update: if isGoogleUser()
        && request.auth.uid == userId
        && (
          (
            request.resource.data.diff(resource.data).changedKeys().hasOnly(['language', 'updatedAt'])
            && request.resource.data.language in ['en', 'uk']
          )
          || (
            isAdmin(appId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminTableColumns', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    match /artifacts/{appId}/users/{userId}/clockSync/{syncId} {
      allow read: if isGoogleUser()
        && request.auth.uid == userId;
      allow create, update: if isGoogleUser()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['serverReceivedAt', 'clientSentAt', 'sampleId'])
        && request.resource.data.serverReceivedAt == request.time
        && (request.resource.data.clientSentAt is int || request.resource.data.clientSentAt is float)
        && request.resource.data.sampleId is string;
      allow delete: if false;
    }

    function roomParticipantOrHost(room, uid) {
      return room.hostId == uid || uid in room.players;
    }

    function validReservation(appId, code) {
      let gameId = request.resource.data.gameId;
      let roomPath = /databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(gameId);
      let room = getAfter(roomPath).data;
      return code.matches('^[0-9]{6}$')
        && request.resource.data.keys().hasOnly(['gameId'])
        && gameId is string
        && gameId.matches('^[A-Za-z0-9]{20}$')
        && !exists(roomPath)
        && !exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/rooms/$(code))
        && room.roomCode == code
        && room.hostId == request.auth.uid
        && room.status == 'lobby';
    }

    function canJoinLobby(before, after, uid) {
      return before.status == 'lobby'
        && after.status == before.status
        && !(uid in before.players)
        && uid in after.players
        && after.players[uid].isHost == false
        && after.diff(before).changedKeys().hasOnly(['players']);
    }

    function validTrueCompetitiveModeUpdate(before, after, uid) {
      return !after.diff(before).affectedKeys().hasAny(['trueCompetitiveMode'])
        || (
          before.hostId == uid
          && before.status == 'lobby'
          && after.status == 'lobby'
          && after.trueCompetitiveMode is bool
        );
    }

    function canHostPack(appId, packId, uid) {
      let pack = get(/databases/$(database)/documents/artifacts/$(appId)/public/data/packs/$(packId)).data;
      return pack.ownerId == uid || pack.isPublic == true;
    }

    function isAdmin(appId) {
      return request.auth != null
        && get(/databases/$(database)/documents/artifacts/$(appId)/users/$(request.auth.uid)).data.admin == true;
    }

    function isGoogleUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
  }
}
